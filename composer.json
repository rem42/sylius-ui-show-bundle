{
    "name": "rem42/sylius-ui-show-bundle",
    "type": "symfony-bundle",
    "description": "Configuration-driven \"show\" pages for the Sylius Stack (Admin UI, Bootstrap Admin UI or Shadcn Admin UI, Twig Hooks) and any Symfony application.",
    "license": "MIT",
    "authors": [
        {
            "name": "Rem42",
            "homepage": "https://github.com/rem42"
        }
    ],
    "keywords": [
        "sylius",
        "sylius-stack",
        "symfony",
        "bundle",
        "show",
        "admin",
        "tabler",
        "tailwind",
        "shadcn",
        "twig-hooks"
    ],
    "require": {
        "php": "^8.4",
        "psr/container": "^1.1 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/type-info": "^7.4 || ^8.0",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.3",
        "matthiasnoback/symfony-dependency-injection-test": "^6.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rem42/shadcn-admin-ui": "^1.0",
        "sylius/twig-hooks": "^0.14",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0",
        "rem42/php-cs-fixer-config": "^4.1",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Guesses fields from the Doctrine mapping (associations, column types, enums).",
        "rem42/shadcn-admin-ui": "Tailwind CSS / shadcn admin theme matching the \"shadcn\" templates.",
        "sylius/bootstrap-admin-ui": "Tabler/Bootstrap admin theme matching the \"bootstrap\" templates.",
        "sylius/twig-hooks": "Renders shows automatically on Sylius Admin UI show pages and enables the Hook element."
    },
    "autoload": {
        "psr-4": {
            "Rem42\\SyliusUiShow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Application/src/",
            "Tests\\Rem42\\SyliusUiShow\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyse": [
            "@php vendor/bin/ecs check",
            "@php vendor/bin/phpstan analyse --memory-limit=-1"
        ],
        "fix": "@php vendor/bin/ecs check --fix",
        "test": "@php vendor/bin/phpunit"
    }
}
