{%- if value is null or value is same as('') -%}
    {{ include('@Rem42SyliusUiShow/bootstrap/field/_empty.html.twig') }}
{%- elseif field.mode == 'mask' -%}
    {%- set text = value|rem42_sylius_ui_show_string -%}
    {%- set visible = min(field.visible, text|length) -%}
    {%- set hidden = text|length - visible -%}
    <span class="font-monospace">
        {%- if hidden > 0 %}{% for i in 1..hidden %}{{ field.char }}{% endfor %}{% endif -%}
        {{- visible > 0 ? text|slice(hidden) : '' -}}
    </span>
{%- else -%}
    <style>.rem42-sylius-ui-show-sensitive{filter:blur(var(--rem42-sylius-ui-show-blur,5px));transition:filter .3s ease;cursor:pointer}.rem42-sylius-ui-show-sensitive:hover,.rem42-sylius-ui-show-sensitive:focus{filter:none}</style>
    <span class="rem42-sylius-ui-show-sensitive d-inline-block" style="--rem42-sylius-ui-show-blur: {{ field.blurRadius }};" tabindex="0">{{ value|rem42_sylius_ui_show_string }}</span>
{%- endif -%}
