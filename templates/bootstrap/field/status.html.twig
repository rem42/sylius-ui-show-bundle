{%- if value is null or value is same as('') -%}
    {{ include('@Rem42SyliusUiShow/bootstrap/field/_empty.html.twig') }}
{%- else -%}
    {%- set key = value.value ?? value.name ?? value -%}
    {%- set color = field.colorMapping[key] ?? 'secondary' -%}
    <span class="status status-{{ color }}">
        <span class="status-dot{% if field.animated %} status-dot-animated{% endif %}"></span>
        {{ value|rem42_sylius_ui_show_string }}
    </span>
{%- endif -%}
