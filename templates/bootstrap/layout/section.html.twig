<div{{ rem42_sylius_ui_show_attributes(element, {class: 'row'}) }}>
    {%- for child in element.children -%}
        {%- if child.type == 'column' -%}
            {{ rem42_sylius_ui_show_render(child, resource) }}
        {%- else -%}
            <div class="col-12">{{ rem42_sylius_ui_show_render(child, resource) }}</div>
        {%- endif -%}
    {%- endfor -%}
</div>
