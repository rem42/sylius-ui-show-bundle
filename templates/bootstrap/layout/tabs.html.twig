{%- set id_prefix = 'rem42-sylius-ui-show-tabs-' ~ element.name|replace({' ': '-', '.': '-'}) -%}
<div{{ rem42_sylius_ui_show_attributes(element, {class: 'card mb-3'}) }}>
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            {%- for tab in element.children %}
                <li class="nav-item" role="presentation">
                    <a href="#{{ id_prefix }}-{{ loop.index }}" class="nav-link{% if loop.first %} active{% endif %}" data-bs-toggle="tab" role="tab" aria-controls="{{ id_prefix }}-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>
                        {{- rem42_sylius_ui_show_label(tab)|trans({}, tab.translationDomain) -}}
                    </a>
                </li>
            {%- endfor %}
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            {%- for tab in element.children %}
                <div class="tab-pane{% if loop.first %} active show{% endif %}" id="{{ id_prefix }}-{{ loop.index }}" role="tabpanel" tabindex="0">
                    {{- rem42_sylius_ui_show_render(tab, resource) -}}
                </div>
            {%- endfor %}
        </div>
    </div>
</div>
