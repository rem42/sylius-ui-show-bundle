{#- Semantic colors of rem42/sylius-ui-show-bundle, turned into classes by the palette (shared/helper/palette.html.twig). -#}
{%- if value is null or value is same as('') or (value is iterable and value is empty) -%}
    {{ include('@Rem42SyliusUiShow/shadcn/field/_empty.html.twig') }}
{%- else -%}
    <div class="flex flex-wrap gap-1">
        {%- for item in (value is iterable ? value : [value]) -%}
            {%- set key = item.value ?? item.name ?? item -%}
            {%- set badge_color = field.colorMapping[key] ?? field.defaultColor -%}
            {%- set badge_text = item|rem42_sylius_ui_show_string -%}
            <twig:shadcn_admin_ui:badge :color="badge_color" :light="field.outline">{{ badge_text }}</twig:shadcn_admin_ui:badge>
        {%- endfor -%}
    </div>
{%- endif -%}
