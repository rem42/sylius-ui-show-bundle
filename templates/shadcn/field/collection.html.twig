{%- if value is null or value is empty -%}
    <div class="text-muted-foreground">{{ field.emptyMessage|trans }}</div>
{%- elseif field.columns is empty -%}
    <ul class="flex flex-col gap-1">
        {%- for item in value -%}
            <li>{{ item|rem42_sylius_ui_show_string }}</li>
        {%- endfor -%}
    </ul>
{%- else -%}
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="[&_tr]:border-b">
                <tr>
                    {%- for column in field.columns %}
                        <th class="h-10 px-4 text-start font-medium whitespace-nowrap">{{ rem42_sylius_ui_show_label(column)|trans({}, column.translationDomain) }}</th>
                    {%- endfor %}
                </tr>
            </thead>
            <tbody class="[&_tr:last-child]:border-0">
                {%- for item in value %}
                    <tr class="border-b transition-colors hover:bg-muted/50">
                        {%- for column in field.columns %}
                            <td class="px-4 py-2">{{ rem42_sylius_ui_show_render(column, item, {render_label: false}) }}</td>
                        {%- endfor %}
                    </tr>
                {%- endfor %}
            </tbody>
        </table>
    </div>
{%- endif -%}
